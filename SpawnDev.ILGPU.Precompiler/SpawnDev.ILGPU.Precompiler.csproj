<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SpawnDev.ILGPU.Precompiler</AssemblyName>
    <RootNamespace>SpawnDev.ILGPU.Precompiler</RootNamespace>
    <!-- Build-time tool: not the runtime path, never trimmed/AOT'd. -->
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Repo build uses the project; the packaged tool ships against the same package version. -->
    <ProjectReference Include="..\SpawnDev.ILGPU\SpawnDev.ILGPU.csproj" />
  </ItemGroup>

</Project>
