(module
  ;; Big-module barrier repro: matches ILGPU kernel complexity.
  ;; - 20 dummy functions (module padding)
  ;; - 1 kernel function with 275 locals + deep if/else nesting
  ;; - 1 dispatcher function with 34 locals + wait32 barrier
  ;; - Tests whether module size/complexity triggers the V8 wait32 bug
  ;;
  ;; Memory layout (shared):
  ;;   [0]    = arrival counter
  ;;   [4]    = generation
  ;;   [8]    = yield count
  ;;   [12]   = exit flag
  ;;   [16]   = violation counter
  ;;   [20]   = reserved
  ;;   [24..] = data region (totalThreads * 4 bytes)

  (memory (import "env" "memory") 10 10 shared)

  ;; ===== 20 dummy functions (module padding) =====
  ;; Each has varying numbers of locals and some computation to prevent optimization

  (func $dummy0 (param i32) (result i32)
    (local $a i32) (local $b i32) (local $c i32) (local $d i32) (local $e i32)
    (local.set $a (i32.add (local.get 0) (i32.const 1)))
    (local.set $b (i32.mul (local.get $a) (i32.const 3)))
    (local.set $c (i32.sub (local.get $b) (local.get 0)))
    (local.set $d (i32.xor (local.get $c) (local.get $a)))
    (local.set $e (i32.or (local.get $d) (i32.const 42)))
    (i32.add (local.get $e) (local.get $b)))

  (func $dummy1 (param i32) (param i32) (result i32)
    (local $x i32) (local $y i32) (local $z i32) (local $w i32)
    (local $m i32) (local $n i32) (local $p i32) (local $q i32)
    (local.set $x (i32.add (local.get 0) (local.get 1)))
    (local.set $y (i32.mul (local.get $x) (i32.const 7)))
    (local.set $z (i32.shr_u (local.get $y) (i32.const 2)))
    (local.set $w (i32.and (local.get $z) (i32.const 0xFF)))
    (local.set $m (i32.rotl (local.get $w) (i32.const 5)))
    (local.set $n (i32.xor (local.get $m) (local.get $x)))
    (local.set $p (i32.add (local.get $n) (local.get $y)))
    (local.set $q (i32.sub (local.get $p) (local.get $z)))
    (i32.or (local.get $q) (local.get $w)))

  (func $dummy2 (param i32) (result i32)
    (local $i i32) (local $sum i32) (local $tmp i32)
    (local.set $i (i32.const 0))
    (local.set $sum (i32.const 0))
    (block $exit (loop $lp
      (br_if $exit (i32.ge_u (local.get $i) (i32.const 10)))
      (local.set $tmp (i32.mul (local.get $i) (local.get 0)))
      (local.set $sum (i32.add (local.get $sum) (local.get $tmp)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $lp)))
    (local.get $sum))

  (func $dummy3 (param i32) (param i32) (result i32)
    (local $a i32) (local $b i32) (local $c i32) (local $d i32) (local $e i32)
    (local $f i32) (local $g i32) (local $h i32) (local $i i32) (local $j i32)
    (local.set $a (i32.add (local.get 0) (i32.const 100)))
    (local.set $b (i32.sub (local.get 1) (i32.const 50)))
    (local.set $c (i32.mul (local.get $a) (local.get $b)))
    (local.set $d (i32.shr_u (local.get $c) (i32.const 3)))
    (local.set $e (i32.and (local.get $d) (i32.const 0xFFF)))
    (local.set $f (i32.xor (local.get $e) (local.get $a)))
    (local.set $g (i32.or (local.get $f) (local.get $b)))
    (local.set $h (i32.rotl (local.get $g) (i32.const 11)))
    (local.set $i (i32.add (local.get $h) (local.get $c)))
    (local.set $j (i32.sub (local.get $i) (local.get $d)))
    (i32.xor (local.get $j) (local.get $e)))

  (func $dummy4 (param i32) (result i32)
    (local $acc i32) (local $i i32) (local $t1 i32) (local $t2 i32)
    (local $t3 i32) (local $t4 i32)
    (local.set $acc (local.get 0))
    (local.set $i (i32.const 0))
    (block $exit (loop $lp
      (br_if $exit (i32.ge_u (local.get $i) (i32.const 8)))
      (local.set $t1 (i32.shl (local.get $acc) (i32.const 1)))
      (local.set $t2 (i32.xor (local.get $t1) (local.get $acc)))
      (local.set $t3 (i32.shr_u (local.get $t2) (i32.const 3)))
      (local.set $t4 (i32.add (local.get $t3) (local.get $i)))
      (local.set $acc (local.get $t4))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $lp)))
    (local.get $acc))

  (func $dummy5 (param i32) (param i32) (param i32) (result i32)
    (local $r i32) (local $s i32) (local $t i32)
    (local.set $r (i32.add (local.get 0) (local.get 1)))
    (local.set $s (i32.mul (local.get $r) (local.get 2)))
    (local.set $t (i32.xor (local.get $s) (i32.const 0xDEAD)))
    (i32.add (local.get $t) (local.get $r)))

  (func $dummy6 (param i32) (result i32)
    (local $v0 i32) (local $v1 i32) (local $v2 i32) (local $v3 i32)
    (local $v4 i32) (local $v5 i32) (local $v6 i32) (local $v7 i32)
    (local.set $v0 (i32.mul (local.get 0) (i32.const 31)))
    (local.set $v1 (i32.add (local.get $v0) (i32.const 17)))
    (local.set $v2 (i32.xor (local.get $v1) (i32.const 0xABCD)))
    (local.set $v3 (i32.shr_u (local.get $v2) (i32.const 4)))
    (local.set $v4 (i32.rotl (local.get $v3) (i32.const 7)))
    (local.set $v5 (i32.and (local.get $v4) (i32.const 0xFFFF)))
    (local.set $v6 (i32.or (local.get $v5) (local.get $v0)))
    (local.set $v7 (i32.sub (local.get $v6) (local.get $v1)))
    (local.get $v7))

  (func $dummy7 (param i32) (param i32) (result i32)
    (local $x i32)
    (if (result i32) (i32.gt_s (local.get 0) (local.get 1))
      (then
        (local.set $x (i32.sub (local.get 0) (local.get 1)))
        (i32.mul (local.get $x) (i32.const 3)))
      (else
        (local.set $x (i32.sub (local.get 1) (local.get 0)))
        (i32.mul (local.get $x) (i32.const 5)))))

  (func $dummy8 (param i32) (result i32)
    (local $a i32) (local $b i32) (local $c i32)
    (local.set $a (i32.clz (local.get 0)))
    (local.set $b (i32.ctz (local.get 0)))
    (local.set $c (i32.popcnt (local.get 0)))
    (i32.add (local.get $a) (i32.add (local.get $b) (local.get $c))))

  (func $dummy9 (param i32) (result i32)
    (local $i i32) (local $h i32) (local $t i32)
    (local.set $h (i32.const 0))
    (local.set $i (i32.const 0))
    (block $exit (loop $lp
      (br_if $exit (i32.ge_u (local.get $i) (i32.const 16)))
      (local.set $t (i32.xor (local.get $h) (i32.shl (local.get $h) (i32.const 5))))
      (local.set $h (i32.add (local.get $t) (i32.add (local.get 0) (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $lp)))
    (local.get $h))

  (func $dummy10 (param i32) (param i32) (result i32)
    (local $lo i32) (local $hi i32) (local $mid i32) (local $r i32)
    (local.set $lo (i32.const 0))
    (local.set $hi (local.get 1))
    (block $exit (loop $lp
      (br_if $exit (i32.ge_u (local.get $lo) (local.get $hi)))
      (local.set $mid (i32.shr_u (i32.add (local.get $lo) (local.get $hi)) (i32.const 1)))
      (if (i32.lt_u (local.get $mid) (local.get 0))
        (then (local.set $lo (i32.add (local.get $mid) (i32.const 1))))
        (else (local.set $hi (local.get $mid))))
      (br $lp)))
    (local.get $lo))

  (func $dummy11 (param i32) (result i32)
    (local $a i32) (local $b i32) (local $c i32) (local $d i32)
    (local $e i32) (local $f i32)
    (local.set $a (i32.mul (local.get 0) (i32.const 2654435761)))
    (local.set $b (i32.shr_u (local.get $a) (i32.const 16)))
    (local.set $c (i32.xor (local.get $a) (local.get $b)))
    (local.set $d (i32.mul (local.get $c) (i32.const 2246822519)))
    (local.set $e (i32.shr_u (local.get $d) (i32.const 13)))
    (local.set $f (i32.xor (local.get $d) (local.get $e)))
    (local.get $f))

  (func $dummy12 (param i32) (param i32) (result i32)
    (local $s i32) (local $i i32)
    (local.set $s (i32.const 1))
    (local.set $i (i32.const 0))
    (block $exit (loop $lp
      (br_if $exit (i32.ge_u (local.get $i) (local.get 1)))
      (local.set $s (i32.mul (local.get $s) (local.get 0)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $lp)))
    (local.get $s))

  (func $dummy13 (param i32) (result i32)
    (local $x i32) (local $y i32) (local $z i32)
    (local.set $x (local.get 0))
    (if (i32.and (local.get $x) (i32.const 1))
      (then (local.set $x (i32.add (i32.mul (local.get $x) (i32.const 3)) (i32.const 1))))
      (else (local.set $x (i32.shr_u (local.get $x) (i32.const 1)))))
    (local.set $y (i32.xor (local.get $x) (local.get 0)))
    (local.set $z (i32.add (local.get $y) (local.get $x)))
    (local.get $z))

  (func $dummy14 (param i32) (param i32) (result i32)
    (local $gcd_a i32) (local $gcd_b i32) (local $t i32)
    (local.set $gcd_a (local.get 0))
    (local.set $gcd_b (local.get 1))
    (block $exit (loop $lp
      (br_if $exit (i32.eqz (local.get $gcd_b)))
      (local.set $t (i32.rem_u (local.get $gcd_a) (local.get $gcd_b)))
      (local.set $gcd_a (local.get $gcd_b))
      (local.set $gcd_b (local.get $t))
      (br $lp)))
    (local.get $gcd_a))

  (func $dummy15 (param i32) (result i32)
    (local $n i32) (local $a i32) (local $b i32) (local $c i32) (local $i i32)
    (local.set $n (i32.and (local.get 0) (i32.const 15)))
    (local.set $a (i32.const 0))
    (local.set $b (i32.const 1))
    (local.set $i (i32.const 0))
    (block $exit (loop $lp
      (br_if $exit (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $c (i32.add (local.get $a) (local.get $b)))
      (local.set $a (local.get $b))
      (local.set $b (local.get $c))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $lp)))
    (local.get $b))

  (func $dummy16 (param i32) (result i32)
    (local $v i32) (local $i i32)
    (local.set $v (local.get 0))
    (local.set $i (i32.const 0))
    (block $exit (loop $lp
      (br_if $exit (i32.ge_u (local.get $i) (i32.const 32)))
      (local.set $v (i32.xor (local.get $v) (i32.shr_u (local.get $v) (i32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $lp)))
    (local.get $v))

  (func $dummy17 (param i32) (param i32) (param i32) (result i32)
    (local $r i32)
    (local.set $r (local.get 0))
    (if (i32.gt_u (local.get 1) (local.get $r))
      (then (local.set $r (local.get 1))))
    (if (i32.gt_u (local.get 2) (local.get $r))
      (then (local.set $r (local.get 2))))
    (local.get $r))

  (func $dummy18 (param i32) (result i32)
    (local $s i32) (local $i i32) (local $d i32)
    (local.set $s (i32.const 0))
    (local.set $i (local.get 0))
    (block $exit (loop $lp
      (br_if $exit (i32.eqz (local.get $i)))
      (local.set $d (i32.rem_u (local.get $i) (i32.const 10)))
      (local.set $s (i32.add (local.get $s) (local.get $d)))
      (local.set $i (i32.div_u (local.get $i) (i32.const 10)))
      (br $lp)))
    (local.get $s))

  (func $dummy19 (param i32) (param i32) (result i32)
    (local $i i32) (local $j i32) (local $k i32)
    (local $a i32) (local $b i32) (local $c i32) (local $d i32)
    (local.set $a (i32.add (local.get 0) (local.get 1)))
    (local.set $i (i32.const 0))
    (block $exit (loop $lp
      (br_if $exit (i32.ge_u (local.get $i) (i32.const 4)))
      (local.set $b (i32.xor (local.get $a) (i32.shl (local.get $a) (i32.const 13))))
      (local.set $c (i32.xor (local.get $b) (i32.shr_u (local.get $b) (i32.const 17))))
      (local.set $d (i32.xor (local.get $c) (i32.shl (local.get $c) (i32.const 5))))
      (local.set $a (local.get $d))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $lp)))
    (local.get $a))

  ;; ===== KERNEL: 275 locals, deep nesting, calls dummy functions =====
  ;; Simulates a RadixSort-like kernel with scan, scatter, histogram ops
  ;; Returns 1 if more phases needed, 0 if done

  (func $kernel (param $tid i32) (param $phase i32) (param $totalPhases i32)
                (param $dataBase i32) (param $totalThreads i32)
    (result i32)

    ;; 5 params + 270 locals = 275 total
    (local $l0 i32) (local $l1 i32) (local $l2 i32) (local $l3 i32) (local $l4 i32)
    (local $l5 i32) (local $l6 i32) (local $l7 i32) (local $l8 i32) (local $l9 i32)
    (local $l10 i32) (local $l11 i32) (local $l12 i32) (local $l13 i32) (local $l14 i32)
    (local $l15 i32) (local $l16 i32) (local $l17 i32) (local $l18 i32) (local $l19 i32)
    (local $l20 i32) (local $l21 i32) (local $l22 i32) (local $l23 i32) (local $l24 i32)
    (local $l25 i32) (local $l26 i32) (local $l27 i32) (local $l28 i32) (local $l29 i32)
    (local $l30 i32) (local $l31 i32) (local $l32 i32) (local $l33 i32) (local $l34 i32)
    (local $l35 i32) (local $l36 i32) (local $l37 i32) (local $l38 i32) (local $l39 i32)
    (local $l40 i32) (local $l41 i32) (local $l42 i32) (local $l43 i32) (local $l44 i32)
    (local $l45 i32) (local $l46 i32) (local $l47 i32) (local $l48 i32) (local $l49 i32)
    (local $l50 i32) (local $l51 i32) (local $l52 i32) (local $l53 i32) (local $l54 i32)
    (local $l55 i32) (local $l56 i32) (local $l57 i32) (local $l58 i32) (local $l59 i32)
    (local $l60 i32) (local $l61 i32) (local $l62 i32) (local $l63 i32) (local $l64 i32)
    (local $l65 i32) (local $l66 i32) (local $l67 i32) (local $l68 i32) (local $l69 i32)
    (local $l70 i32) (local $l71 i32) (local $l72 i32) (local $l73 i32) (local $l74 i32)
    (local $l75 i32) (local $l76 i32) (local $l77 i32) (local $l78 i32) (local $l79 i32)
    (local $l80 i32) (local $l81 i32) (local $l82 i32) (local $l83 i32) (local $l84 i32)
    (local $l85 i32) (local $l86 i32) (local $l87 i32) (local $l88 i32) (local $l89 i32)
    (local $l90 i32) (local $l91 i32) (local $l92 i32) (local $l93 i32) (local $l94 i32)
    (local $l95 i32) (local $l96 i32) (local $l97 i32) (local $l98 i32) (local $l99 i32)
    (local $l100 i32) (local $l101 i32) (local $l102 i32) (local $l103 i32) (local $l104 i32)
    (local $l105 i32) (local $l106 i32) (local $l107 i32) (local $l108 i32) (local $l109 i32)
    (local $l110 i32) (local $l111 i32) (local $l112 i32) (local $l113 i32) (local $l114 i32)
    (local $l115 i32) (local $l116 i32) (local $l117 i32) (local $l118 i32) (local $l119 i32)
    (local $l120 i32) (local $l121 i32) (local $l122 i32) (local $l123 i32) (local $l124 i32)
    (local $l125 i32) (local $l126 i32) (local $l127 i32) (local $l128 i32) (local $l129 i32)
    (local $l130 i32) (local $l131 i32) (local $l132 i32) (local $l133 i32) (local $l134 i32)
    (local $l135 i32) (local $l136 i32) (local $l137 i32) (local $l138 i32) (local $l139 i32)
    (local $l140 i32) (local $l141 i32) (local $l142 i32) (local $l143 i32) (local $l144 i32)
    (local $l145 i32) (local $l146 i32) (local $l147 i32) (local $l148 i32) (local $l149 i32)
    (local $l150 i32) (local $l151 i32) (local $l152 i32) (local $l153 i32) (local $l154 i32)
    (local $l155 i32) (local $l156 i32) (local $l157 i32) (local $l158 i32) (local $l159 i32)
    (local $l160 i32) (local $l161 i32) (local $l162 i32) (local $l163 i32) (local $l164 i32)
    (local $l165 i32) (local $l166 i32) (local $l167 i32) (local $l168 i32) (local $l169 i32)
    (local $l170 i32) (local $l171 i32) (local $l172 i32) (local $l173 i32) (local $l174 i32)
    (local $l175 i32) (local $l176 i32) (local $l177 i32) (local $l178 i32) (local $l179 i32)
    (local $l180 i32) (local $l181 i32) (local $l182 i32) (local $l183 i32) (local $l184 i32)
    (local $l185 i32) (local $l186 i32) (local $l187 i32) (local $l188 i32) (local $l189 i32)
    (local $l190 i32) (local $l191 i32) (local $l192 i32) (local $l193 i32) (local $l194 i32)
    (local $l195 i32) (local $l196 i32) (local $l197 i32) (local $l198 i32) (local $l199 i32)
    (local $l200 i32) (local $l201 i32) (local $l202 i32) (local $l203 i32) (local $l204 i32)
    (local $l205 i32) (local $l206 i32) (local $l207 i32) (local $l208 i32) (local $l209 i32)
    (local $l210 i32) (local $l211 i32) (local $l212 i32) (local $l213 i32) (local $l214 i32)
    (local $l215 i32) (local $l216 i32) (local $l217 i32) (local $l218 i32) (local $l219 i32)
    (local $l220 i32) (local $l221 i32) (local $l222 i32) (local $l223 i32) (local $l224 i32)
    (local $l225 i32) (local $l226 i32) (local $l227 i32) (local $l228 i32) (local $l229 i32)
    (local $l230 i32) (local $l231 i32) (local $l232 i32) (local $l233 i32) (local $l234 i32)
    (local $l235 i32) (local $l236 i32) (local $l237 i32) (local $l238 i32) (local $l239 i32)
    (local $l240 i32) (local $l241 i32) (local $l242 i32) (local $l243 i32) (local $l244 i32)
    (local $l245 i32) (local $l246 i32) (local $l247 i32) (local $l248 i32) (local $l249 i32)
    (local $l250 i32) (local $l251 i32) (local $l252 i32) (local $l253 i32) (local $l254 i32)
    (local $l255 i32) (local $l256 i32) (local $l257 i32) (local $l258 i32) (local $l259 i32)
    (local $l260 i32) (local $l261 i32) (local $l262 i32) (local $l263 i32) (local $l264 i32)
    (local $l265 i32) (local $l266 i32) (local $l267 i32) (local $l268 i32) (local $l269 i32)

    ;; Initialize locals with tid-dependent values (forces them to be live)
    (local.set $l0 (i32.add (local.get $tid) (i32.const 1)))
    (local.set $l1 (i32.mul (local.get $tid) (i32.const 3)))
    (local.set $l2 (i32.xor (local.get $l0) (local.get $l1)))
    (local.set $l3 (i32.add (local.get $l2) (local.get $phase)))
    (local.set $l4 (i32.shl (local.get $tid) (i32.const 2)))
    (local.set $l5 (i32.or (local.get $l3) (local.get $l4)))
    (local.set $l6 (i32.and (local.get $l5) (i32.const 0xFFFF)))
    (local.set $l7 (i32.sub (local.get $l6) (local.get $l0)))
    (local.set $l8 (i32.rotl (local.get $l7) (i32.const 3)))
    (local.set $l9 (i32.xor (local.get $l8) (local.get $l1)))

    ;; Use dummy functions to add call complexity
    (local.set $l10 (call $dummy0 (local.get $l0)))
    (local.set $l11 (call $dummy1 (local.get $l1) (local.get $l2)))
    (local.set $l12 (call $dummy2 (local.get $l3)))
    (local.set $l13 (call $dummy3 (local.get $l4) (local.get $l5)))
    (local.set $l14 (call $dummy4 (local.get $l6)))
    (local.set $l15 (call $dummy5 (local.get $l7) (local.get $l8) (local.get $l9)))
    (local.set $l16 (call $dummy6 (local.get $l10)))
    (local.set $l17 (call $dummy7 (local.get $l11) (local.get $l12)))
    (local.set $l18 (call $dummy8 (local.get $l13)))
