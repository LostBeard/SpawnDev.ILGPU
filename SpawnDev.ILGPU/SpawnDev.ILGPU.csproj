<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>4.9.9-local.3</Version>
		<PackageReleaseNotes>v4.9.9-local.3: NEW unified `CopyFromAsync` extension API on `ArrayView&lt;T&gt;`, `ArrayView1D&lt;T,TStride&gt;`, and `MemoryBuffer1D&lt;T,TStride&gt;`. Mirrors the sync `CopyFrom` signatures and is backend-agnostic across all 6 backends (WebGPU, WebGL, Wasm, CUDA, OpenCL, CPU). On Wasm, awaits the source/destination accelerator's pending kernel dispatches before issuing the copy - closes the Blazor-WASM-only main-thread race where the sync `CopyFrom` code path read `SharedArrayBuffer` while worker kernels were still writing it (manifested as GPU→GPU copies returning stale/partial bytes immediately after an unawaited kernel dispatch). On other backends the implicit drain is a no-op since their command encoder / GL worker message queue / accelerator stream already serialize the copy after pending work. Use for GPU→GPU copies that follow an unawaited kernel dispatch in async consumer code, mirroring `CopyToHostAsync`'s implicit-sync contract. v4.9.9-local.2: WebGL GPU→GPU CopyTo/CopyFrom stale-data fix. The previous implementation read from `_backingArray` (the CPU-side Uint8Array) which is never refreshed after a kernel Transform Feedback write — only the worker's `entry.data` typed array is updated, on the worker thread (OffscreenCanvas process). Consequence: `dstBuf.View.CopyFrom(kernelOutputView)` produced all zeros because it read stale CPU-side bytes. Manifested as the "MemoryBuffer2D&lt;T&gt;.BaseView kernel-write silently zeros" symptom that blocked the ML Phase 2 TensorView migration on WebGL — but the 2D angle was a red herring, the same bug fired on Allocate1D&lt;T&gt; output buffers when staged through CopyFrom. Fix: route WebGL→WebGL CopyTo/CopyFrom through a new worker-side `copyBuffer` message that copies between worker `entry.data` arrays and re-uploads the destination texture, keeping the worker's canonical post-kernel state intact. Source `_backingArray` is no longer touched. WebGL full sweep: 484 pass / 0 fail / 144 skip (no regressions). Repro test: `BackendTestBase.Tests24.TensorViewStructParam.CopyFrom_After_KernelWrite_Sees_Kernel_Output`. Carries forward v4.9.9-local.1 WebGPU scalar-slot drift fix for body-struct + trailing-scalar kernels.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.ILGPU</Title>
		<Authors>LostBeard</Authors>
		<Description>.Net GPU compute for the browser and desktop. Write once, run on WebGPU, WebGL, Wasm, CUDA, OpenCL, and CPU.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.ILGPU</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.ILGPU.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;Cuda;OpenCL;WebGPU;WebGL;WebAssembly;Multithreading;WebWorkers;GPGPU;ILGPU;ParallelProcessing;ComputeShader;CrossPlatform</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
		<PackageReference Include="SpawnDev.BlazorJS" Version="3.5.3" />
	</ItemGroup>

	<!-- =====================================================================
	     CRITICAL: FOUR-PACKAGE BUNDLE - read before bumping any one of these.
	     =====================================================================
	     A bug fixed under ILGPU/ ships in ILGPU.dll which lives in the SEPARATE
	     SpawnDev.ILGPU.Fork nupkg, NOT in this SpawnDev.ILGPU wrapper. If you
	     bump only this csproj, consumers transitively pull the OLD Fork from
	     nuget.org and the fix is invisible to them. To ship an ILGPU/ fix you
	     MUST bump all four together:

	       (1) ILGPU/ILGPU.csproj                                  <Version>
	       (2) ILGPU.Algorithms/ILGPU.Algorithms.csproj            <Version>
	       (3) SpawnDev.ILGPU/SpawnDev.ILGPU.csproj                <Version>
	       (4) The TWO PackageReference lines IMMEDIATELY BELOW
	           (the !Exists branch) - in-repo dev uses ProjectReference and
	           does not see these; the published nuspec dependency does.

	     Then run _check-fork-version-sync.bat at repo root to verify all four
	     match before commit. CI runs the same check on every push. If you skip
	     step (4) the consumer ships rc.N with stale Fork 2.0.x and the fix
	     never reaches the IR. This is exactly what bit rc.28 on 2026-04-28.
	     ===================================================================== -->
	<!-- Conditional fork reference: in-repo dev uses ProjectReference (fast iteration); external consumers use PackageReference via NuGet -->
	<ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\ILGPU\ILGPU.csproj')">
		<ProjectReference Include="..\ILGPU\ILGPU.csproj" />
		<ProjectReference Include="..\ILGPU.Algorithms\ILGPU.Algorithms.csproj" />
	</ItemGroup>
	<ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\ILGPU\ILGPU.csproj')">
		<PackageReference Include="SpawnDev.ILGPU.Fork" Version="2.0.7" />
		<PackageReference Include="SpawnDev.ILGPU.Algorithms.Fork" Version="2.0.7" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="wwwroot\icon-128.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="wwwroot\icon-128.png" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

</Project>
