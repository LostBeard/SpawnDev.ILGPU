<#
string vecName = "Vector" + vecBits;
string opsClass = "Vec" + vecBits + "Operations";
string vecClass = "Vec" + vecBits;
int warpSize = vecBits / 32;
int half = warpSize / 2;
string Join(int from, int to, Func<int, string> f) =>
    string.Join(", ", Enumerable.Range(from, to - from).Select(f));
#>
