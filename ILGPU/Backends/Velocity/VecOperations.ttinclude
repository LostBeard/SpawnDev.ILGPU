                    sourceValue.GetElement(<#= i #>));
            }
<#          } #>
            return <#= GetCastXToI32(targetPrefix,
                Create32(i => "result" + i)) #>;
        }

<#      } #>

<#      foreach (var (_, prefix, typeName, _) in ImplementationTypes64) { #>
