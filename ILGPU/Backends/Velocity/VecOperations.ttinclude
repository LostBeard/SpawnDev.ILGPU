<#          var targetTypeName = isBinary ? "uint" : typeName; #>
        [MethodImpl(MethodImplOptions.<#= inliningAttribute #>)]
        internal static unsafe <#= warpType32 #> Atomic<#= op #><#= prefix #>32(
            <#= warpType32 #> mask,
